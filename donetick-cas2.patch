diff --git a/internal/chore/repo/household_cas_test.go b/internal/chore/repo/household_cas_test.go
new file mode 100644
index 0000000..455ae08
--- /dev/null
+++ b/internal/chore/repo/household_cas_test.go
@@ -0,0 +1,134 @@
+package chore
+
+import (
+	"context"
+	chModel "donetick.com/core/internal/chore/model"
+	cModel "donetick.com/core/internal/circle/model"
+	syncModel "donetick.com/core/internal/sync/model"
+	"errors"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+	"sync"
+	"testing"
+	"time"
+)
+
+func householdCASFixture(t *testing.T) (*ChoreRepository, *gorm.DB, chModel.Chore, time.Time, time.Time) {
+	r, db := newVisibilityTestRepository(t)
+	require.NoError(t, db.AutoMigrate(&chModel.ChoreHistory{}, &chModel.TimeSession{}))
+	sqlDB, err := db.DB()
+	require.NoError(t, err)
+	sqlDB.SetMaxOpenConns(1)
+	t.Cleanup(func() { sqlDB.Close() })
+	due := time.Date(2026, 10, 1, 8, 0, 0, 0, time.UTC)
+	next := due.Add(24 * time.Hour)
+	p := 3
+	ch := chModel.Chore{ID: 900, CircleID: 1, CreatedBy: 1, Name: "CAS fixture", SyncVersion: 7, IsActive: true, NextDueDate: &due, Points: &p, FrequencyType: "daily"}
+	seedVisibilityTest(t, db, &ch, 1)
+	require.NoError(t, db.Create(&syncModel.SyncCursor{CircleID: 1, EntityType: syncModel.EntityTypeChore, MaxVersion: 7}).Error)
+	return r, db, ch, due, next
+}
+func householdCASAssert(t *testing.T, db *gorm.DB, ch chModel.Chore, next time.Time) {
+	var histories []chModel.ChoreHistory
+	require.NoError(t, db.Where("chore_id = ?", ch.ID).Find(&histories).Error)
+	require.Len(t, histories, 1)
+	require.Equal(t, *ch.NextDueDate, *histories[0].DueDate)
+	var actual chModel.Chore
+	require.NoError(t, db.First(&actual, ch.ID).Error)
+	require.Equal(t, next, *actual.NextDueDate)
+	require.Equal(t, int64(8), actual.SyncVersion)
+	var user cModel.UserCircle
+	require.NoError(t, db.Where("user_id = ? AND circle_id = ?", 1, ch.CircleID).First(&user).Error)
+	require.Equal(t, 3, user.Points)
+}
+func TestHouseholdCASNormalCompletion(t *testing.T) {
+	r, db, ch, due, next := householdCASFixture(t)
+	require.NoError(t, r.CompleteChore(context.Background(), &ch, nil, 1, &next, &due, nil, true))
+	householdCASAssert(t, db, ch, next)
+}
+func TestHouseholdCASConcurrentSameOccurrence(t *testing.T) {
+	r, db, ch, due, next := householdCASFixture(t)
+	start := make(chan struct{})
+	results := make(chan error, 2)
+	var wg sync.WaitGroup
+	for i := 0; i < 2; i++ {
+		snapshot := ch
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			results <- r.CompleteChore(context.Background(), &snapshot, nil, 1, &next, &due, nil, true)
+		}()
+	}
+	close(start)
+	wg.Wait()
+	close(results)
+	success, conflicts := 0, 0
+	for err := range results {
+		if err == nil {
+			success++
+		} else if errors.Is(err, ErrChoreConflict) {
+			conflicts++
+		} else {
+			t.Fatal(err)
+		}
+	}
+	require.Equal(t, 1, success)
+	require.Equal(t, 1, conflicts)
+	householdCASAssert(t, db, ch, next)
+}
+func TestHouseholdCASStaleEditCannotUndoCompletion(t *testing.T) {
+	r, db, ch, due, next := householdCASFixture(t)
+	old := ch
+	require.NoError(t, r.CompleteChore(context.Background(), &ch, nil, 1, &next, &due, nil, true))
+	old.Name = "Stale edit"
+	require.ErrorIs(t, r.UpdateChoreVisibility(context.Background(), &old, []int{1}), ErrChoreConflict)
+	householdCASAssert(t, db, ch, next)
+	var actual chModel.Chore
+	require.NoError(t, db.First(&actual, ch.ID).Error)
+	require.Equal(t, "CAS fixture", actual.Name)
+}
+
+func TestHouseholdFloorResetAtomicNoExtraHistoryOrPoints(t *testing.T) {
+	r, db, mop, due, next := householdCASFixture(t)
+	vacuum := mop
+	vacuum.ID = 901
+	vacuum.Name = "Vacuum fixture"
+	require.NoError(t, db.Create(&vacuum).Error)
+	require.NoError(t, db.Create(&chModel.ChoreAssignees{ChoreID: vacuum.ID, UserID: 1}).Error)
+	resetDue := due.Add(72 * time.Hour)
+	require.NoError(t, r.CompleteChore(context.Background(), &mop, nil, 1, &next, &due, nil, true,
+		HouseholdFloorReset{Chore: &vacuum, NextDueDate: &resetDue}))
+	var actual chModel.Chore
+	require.NoError(t, db.First(&actual, vacuum.ID).Error)
+	require.Equal(t, resetDue, *actual.NextDueDate)
+	require.Equal(t, int64(9), actual.SyncVersion)
+	var count int64
+	require.NoError(t, db.Model(&chModel.ChoreHistory{}).Count(&count).Error)
+	require.Equal(t, int64(1), count)
+	var user cModel.UserCircle
+	require.NoError(t, db.Where("user_id = ? AND circle_id = ?", 1, mop.CircleID).First(&user).Error)
+	require.Equal(t, 3, user.Points)
+}
+
+func TestHouseholdFloorResetStaleRelatedRollsBackWholeCompletion(t *testing.T) {
+	r, db, mop, due, next := householdCASFixture(t)
+	vacuum := mop
+	vacuum.ID = 901
+	require.NoError(t, db.Create(&vacuum).Error)
+	require.NoError(t, db.Create(&chModel.ChoreAssignees{ChoreID: vacuum.ID, UserID: 1}).Error)
+	stale := vacuum
+	stale.SyncVersion = 6
+	require.ErrorIs(t, r.CompleteChore(context.Background(), &mop, nil, 1, &next, &due, nil, true,
+		HouseholdFloorReset{Chore: &stale, NextDueDate: &next}), ErrChoreConflict)
+	var actual chModel.Chore
+	require.NoError(t, db.First(&actual, mop.ID).Error)
+	require.Equal(t, due, *actual.NextDueDate)
+	require.Equal(t, int64(7), actual.SyncVersion)
+	var count int64
+	require.NoError(t, db.Model(&chModel.ChoreHistory{}).Count(&count).Error)
+	require.Equal(t, int64(0), count)
+	var user cModel.UserCircle
+	require.NoError(t, db.Where("user_id = ? AND circle_id = ?", 1, mop.CircleID).First(&user).Error)
+	require.Equal(t, 0, user.Points)
+}
